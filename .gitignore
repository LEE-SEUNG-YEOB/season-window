# ============================================================
# 데이터: 원본과 정제본은 저장소에 올리지 않는다
# (상업적 이용 제한 조건이 있고 재배포 가능 여부 미확인)
# data/ 아래는 폴더 뼈대(.gitkeep)와 README만 올라간다
# ============================================================
data/**
!data/**/
!data/**/.gitkeep
!data/README.md

# 안전장치: data/ 밖에 실수로 둔 원본·정제본도 막는다
*.xlsx
*.xls
*.parquet
*.feather
OBS_ASOS_*.csv

# 올려도 되는 것: 차트 이미지, 집계 결과(reports/), 지점 연결표(reference/)
# -> 별도 규칙 없이 그대로 추적된다. 단, 줄 단위 관측 기록은 reports/에 저장하지 말 것

# ---------------- Python ----------------
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/
*.egg-info/

# ---------------- 비밀값 ----------------
.env
.env.*
*.key

# ---------------- OS / 편집기 ----------------
.DS_Store
Thumbs.db
desktop.ini
~$*
.vscode/
.idea/

# 내부 시연 빌드 산출물
/service/offline/outputs/

# 내부 시연 결과물은 어디에 만들어도 막는다 (해별 날짜가 그대로 들어 있음)
*내부시연*.html
데이터_조사결과.json

# 수업 시연판: 해별 날짜가 든 자료 파일이 있어 폴더째 막는다 (화면 예시는 reports/demo/)
/demo/

# 배포와 영상 작업 부산물
.vercel/
node_modules/
reports/video/frames/
reports/video/stills/
